<Application x:Class="Swip.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Fila de lista pulsable (bordes redondeados) -->
        <Style x:Key="ListRow" TargetType="Button">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Background" Value="#FF2A2B2E" />
            <Setter Property="Foreground" Value="#FFE8EAED" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF3C4043" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Fila de lista destacada (acción principal: Cambiar) -->
        <Style x:Key="ListRowAccent" TargetType="Button" BasedOn="{StaticResource ListRow}">
            <Setter Property="Background" Value="#FFFFC400" />
            <Setter Property="Foreground" Value="#FF202124" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFFFD633" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Muestra de color (swatch) redonda para elegir el color del gato -->
        <Style x:Key="Swatch" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="13"
                                BorderBrush="#FF55585C" BorderThickness="1" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value><ScaleTransform ScaleX="1.15" ScaleY="1.15" /></Setter.Value>
                    </Setter>
                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Tarjeta de lista no pulsable (encabezado / item de app) -->
        <Style x:Key="ListCard" TargetType="Border">
            <Setter Property="Background" Value="#FF2A2B2E" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </Application.Resources>
</Application>
