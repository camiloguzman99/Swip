<Application x:Class="Swip.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Color de énfasis: valores por defecto; App.xaml.cs los sobrescribe con el de Windows. -->
        <SolidColorBrush x:Key="AccentBrush" Color="#FFFFC400" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#FFFFD633" />
        <SolidColorBrush x:Key="AccentFgBrush" Color="#FF202124" />

        <!-- Fila de lista pulsable: transparente, solo resalta con el mouseover -->
        <Style x:Key="ListRow" TargetType="Button">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Background" Value="#66000000" />
            <Setter Property="Foreground" Value="#FFE8EAED" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#33FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Fila destacada (Cambiar a esta sesión): verde -->
        <Style x:Key="ListRowAccent" TargetType="Button" BasedOn="{StaticResource ListRow}">
            <Setter Property="Background" Value="#FF2E9E4F" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF37BB5E" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Fila de lista deshabilitada (p. ej. "Sesión activa") -->
        <Style x:Key="ListRowDisabled" TargetType="Border">
            <Setter Property="Background" Value="#22FFFFFF" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <!-- Botón rueda de configuración (⚙) -->
        <Style x:Key="GearBtn" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#FFE8EAED" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="#33FFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#55FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Muestra de color (swatch) redonda para elegir el color del gato -->
        <Style x:Key="Swatch" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="13"
                                BorderBrush="#FF55585C" BorderThickness="1" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value><ScaleTransform ScaleX="1.15" ScaleY="1.15" /></Setter.Value>
                    </Setter>
                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Tarjeta de lista no pulsable (encabezado / item de app) -->
        <Style x:Key="ListCard" TargetType="Border">
            <Setter Property="Background" Value="#66000000" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </Application.Resources>
</Application>
