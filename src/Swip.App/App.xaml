<Application x:Class="Swip.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Botón compacto para la fila de opciones del menú -->
        <Style x:Key="OptBtn" TargetType="Button">
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Background" Value="#FF2A2B2E" />
            <Setter Property="Foreground" Value="#FFE8EAED" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF3C4043" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
