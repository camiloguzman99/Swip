<UserControl x:Class="Swip.App.Controls.CatSprite"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <!-- El control mide lo que el cuadro de dibujo (72x72 casillas = px lógicos), en T: principal de
         48x48 (los pies sobre la base), 12 a cada lado y 24 por debajo del principal. -->
    <Grid>
        <!-- Sombra sobre la base: se queda en la superficie aunque el gato salte, y encoge al subir.
             Su posición vertical (la base) la fija el código. -->
        <Ellipse x:Name="Shadow" Width="26" Height="6" Fill="#FF000000" Opacity="0.25"
                 HorizontalAlignment="Center" VerticalAlignment="Top"
                 IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="ShadowScale" />
                    <TranslateTransform x:Name="ShadowShift" />
                </TransformGroup>
            </Ellipse.RenderTransform>
        </Ellipse>

        <!-- El cuadro de dibujo: el fotograma y su marco se desplazan juntos (saltos en el sitio). -->
        <Grid x:Name="Cell" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="Shift" />
            </Grid.RenderTransform>

            <!-- Fotograma: su cuadrícula (1 casilla = 1 px lógico), ya espejada y ampliada en el atlas.
                 Nunca se deforma. El modo de escalado lo elige el código según la pantalla (PixelScale). -->
            <Image x:Name="Img" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />

            <!-- Marcos del cuadro de dibujo, siempre visibles (líneas de 1 px real): zonas extra en azul,
                 principal en verde y base en magenta. Sirven para comprobar que nada se deforma. -->
            <Image x:Name="Zones" Stretch="Fill" IsHitTestVisible="False"
                   RenderOptions.BitmapScalingMode="NearestNeighbor" />
        </Grid>

        <!-- Rótulo con el nombre del usuario, ENCIMA del gato. Se coloca arriba desplazándolo con
             LabelShift (código), así que no cambia el tamaño del control: si no, el gato se hundiría.
             No se puede seleccionar ni pulsar: IsHitTestVisible=False. -->
        <Border x:Name="LabelBox" Background="#AA202124" CornerRadius="4" Padding="4,1"
                HorizontalAlignment="Center" VerticalAlignment="Top" IsHitTestVisible="False">
            <Border.RenderTransform>
                <TranslateTransform x:Name="LabelShift" />
            </Border.RenderTransform>
            <TextBlock x:Name="NameLabel" Foreground="{DynamicResource AccentBrush}" FontSize="9"
                       FontFamily="Consolas" TextAlignment="Center" IsHitTestVisible="False"
                       TextTrimming="CharacterEllipsis" MaxWidth="110" />
        </Border>
    </Grid>
</UserControl>
