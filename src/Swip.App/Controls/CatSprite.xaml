<UserControl x:Class="Swip.App.Controls.CatSprite"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <!-- Sprite del gato (arte del usuario). Se espeja según la dirección. -->
        <Image x:Name="Img" Stretch="Fill" RenderTransformOrigin="0.5,0.5"
               RenderOptions.BitmapScalingMode="HighQuality">
            <Image.RenderTransform>
                <ScaleTransform x:Name="Flip" ScaleX="1" ScaleY="1" />
            </Image.RenderTransform>
        </Image>

        <!-- Corazón al acariciar -->
        <TextBlock x:Name="Heart" Text="&#x2665;" Foreground="#FFFF6E8A" FontSize="18"
                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-6,0,0"
                   Visibility="Collapsed" />

        <!-- Etiqueta con el nombre de la sesión -->
        <Border x:Name="LabelBox" Background="#AA202124" CornerRadius="4" Padding="4,1"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-2">
            <TextBlock x:Name="NameLabel" Foreground="#FFFFE08A" FontSize="9"
                       FontFamily="Consolas" TextTrimming="CharacterEllipsis" MaxWidth="110" />
        </Border>
    </Grid>
</UserControl>
