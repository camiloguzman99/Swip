<Window x:Class="Swip.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Swip"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="Manual">

    <Grid>
        <!-- Área transparente donde merodean los gatos. Fondo null: solo los gatos capturan clics. -->
        <Canvas x:Name="Yard" Background="{x:Null}" />

        <!-- Aviso cuando no hay gatos (p. ej. el servicio no está en ejecución) -->
        <Border x:Name="EmptyHint" Background="#CC202124" CornerRadius="8" Padding="12,8"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8"
                Visibility="Collapsed">
            <TextBlock x:Name="EmptyHintText" Foreground="#FFFFD633" FontSize="12"
                       FontFamily="Consolas" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420" />
        </Border>

        <!-- Menú de información por gato (clic derecho). Su DataContext se fija al gato pulsado. -->
        <Popup x:Name="InfoPopup" Placement="Top" StaysOpen="False"
               AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="#FF202124" CornerRadius="10" Padding="12" MinWidth="260"
                    BorderBrush="#FFFFC400" BorderThickness="1.5">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.5" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="{Binding DisplayName}" Foreground="#FFFFD633"
                               FontWeight="Bold" FontSize="14" FontFamily="Consolas" />
                    <TextBlock Text="{Binding StateText}" Foreground="#FFB0B0B0"
                               FontSize="11" Margin="0,2,0,8" />

                    <TextBlock Text="Apps activas:" Foreground="#FF9AA0A6" FontSize="11"
                               Margin="0,0,0,2" />
                    <ItemsControl ItemsSource="{Binding Apps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="#FFDADCE0" FontSize="11"
                                           Margin="6,1,0,1" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Cargando apps…" Foreground="#FF808080" FontSize="11" Margin="6,2,0,0"
                               Visibility="{Binding AppsLoading, Converter={StaticResource BoolToVis}}" />

                    <Button Content="Cambiar a esta sesión" Margin="0,10,0,0" Padding="8,5"
                            Tag="{Binding SessionId}" Click="Switch_Click"
                            Visibility="{Binding CanSwitch, Converter={StaticResource BoolToVis}}"
                            Background="#FFFFC400" Foreground="#FF202124"
                            FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" />

                    <Separator Margin="0,10,0,8" Background="#FF3C4043" />

                    <TextBlock Text="Opciones" Foreground="#FF9AA0A6" FontSize="10" Margin="0,0,0,4" />
                    <WrapPanel>
                        <Button Content="Gatos +" Click="CatsBigger_Click" Style="{StaticResource OptBtn}" />
                        <Button Content="Gatos −" Click="CatsSmaller_Click" Style="{StaticResource OptBtn}" />
                        <Button Content="Franja +" Click="StripTaller_Click" Style="{StaticResource OptBtn}" />
                        <Button Content="Franja −" Click="StripShorter_Click" Style="{StaticResource OptBtn}" />
                        <Button Content="Recolocar" Click="SnapToTaskbar_Click" Style="{StaticResource OptBtn}" />
                        <Button Content="Etiquetas" Click="ToggleLabels_Click" Style="{StaticResource OptBtn}" />
                        <Button Content="Actualizar" Click="Update_Click" Style="{StaticResource OptBtn}" />
                        <Button Content="Salir" Click="Exit_Click" Style="{StaticResource OptBtn}" />
                    </WrapPanel>

                    <TextBlock x:Name="StatusText" Foreground="#FFFF8A65" FontSize="11"
                               TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
