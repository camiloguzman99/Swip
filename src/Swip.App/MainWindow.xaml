<Window x:Class="Swip.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Swip.App.Controls"
        Title="Swip"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        UseLayoutRounding="True">

    <Grid>
        <!-- Área transparente donde merodean los gatos y vive la caja. -->
        <Canvas x:Name="Yard" Background="{x:Null}">
            <!-- Caja de configuración (arrastrable). Posición fijada en código. -->
            <!-- La caja es una cuadrícula (BoxSprites): el tambaleo se dibuja con píxeles, girándola
                 dentro de su cuadro de dibujo; las casillas nunca se inclinan ni se estiran. -->
            <!-- Capa trasera de la caja (el interior de la abierta): detrás del gato que está dentro. -->
            <Image x:Name="BoxBack" Stretch="Fill" IsHitTestVisible="False" Panel.ZIndex="-2"
                   RenderOptions.BitmapScalingMode="NearestNeighbor" />
            <Image x:Name="Box" Cursor="Hand" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"
                   MouseLeftButtonDown="Box_Down" MouseMove="Box_Move" MouseLeftButtonUp="Box_Up"
                   MouseRightButtonUp="BoxRight_Click" />
        </Canvas>

        <!-- Partículas del motor (zzz, corazones, polvo...). Encima de todo y sin recibir clics. -->
        <controls:EffectsLayer x:Name="Effects" />

        <!-- Menú de cada gato (clic derecho), en 3 niveles. El encabezado se puede arrastrar. -->
        <Popup x:Name="InfoPopup" Placement="Custom" StaysOpen="False"
               AllowsTransparency="True" PopupAnimation="Fade" Opened="Popup_Opened">
            <Border Background="{StaticResource MenuPanelBrush}" CornerRadius="{StaticResource MenuCornerRadius}" Padding="12" Width="320">
                <StackPanel>
                    <!-- NIVEL 1: nombre (50 %), CPU (25 %) y RAM (25 %). Arrastrable. Las mismas proporciones
                         y colores que las filas de las aplicaciones, para entenderlo de un vistazo. -->
                    <Border x:Name="CatHeader" Style="{StaticResource ListCard}"
                            Cursor="SizeAll"
                            MouseLeftButtonDown="InfoHeader_Down" MouseMove="InfoHeader_Move"
                            MouseLeftButtonUp="InfoHeader_Up">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding DisplayName}" Foreground="#FFFFFFFF"
                                       FontWeight="Bold" FontSize="13" FontFamily="Consolas"
                                       TextAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <!-- CPU y RAM solo tienen sentido con la sesión abierta -->
                            <TextBlock Grid.Column="1" Text="CPU" Foreground="#FF8FD0FF" FontWeight="SemiBold"
                                       FontSize="11" FontFamily="Consolas" TextAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding HasSession, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Grid.Column="2" Text="RAM" Foreground="#FFB7E39C" FontWeight="SemiBold"
                                       FontSize="11" FontFamily="Consolas" TextAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding HasSession, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Border>

                    <!-- Separador 1px (encima de las apps) -->
                    <Border Height="1" Background="#40FFFFFF" Margin="2,6,2,2" />

                    <!-- NIVEL 2: apps abiertas en la otra sesión (50 % / 25 % / 25 %). Al pedir confirmar el
                         inicio de sesión se oculta y en su lugar va el aviso. -->
                    <StackPanel Visibility="{Binding ShowApps, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding Apps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ListCard}" Padding="12,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="#FFDADCE0"
                                                       FontSize="11" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding Cpu}" Foreground="#FF8FD0FF"
                                                       FontSize="11" FontFamily="Consolas" TextAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding Ram}" Foreground="#FFB7E39C"
                                                       FontSize="11" FontFamily="Consolas" TextAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Style="{StaticResource ListCard}" Padding="12,6"
                                Visibility="{Binding AppsLoading, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Cargando…" Foreground="#FF808080" FontSize="11" />
                        </Border>
                    </StackPanel>

                    <!-- Aviso de «Iniciar sesión» (antes una ventana emergente): ocupa el sitio de las aplicaciones. -->
                    <Border Style="{StaticResource ListCard}" Padding="12,6"
                            Visibility="{Binding ConfirmingLogon, Converter={StaticResource BoolToVis}}">
                        <TextBlock Foreground="#FFDADCE0" FontSize="12" TextWrapping="Wrap" TextAlignment="Justify"
                                   Text="Se mostrará la pantalla de inicio de sesión de Windows para que inicies esta cuenta. Tu sesión actual quedará abierta en segundo plano. ¿Continuar?" />
                    </Border>

                    <!-- Separador 1px (debajo de las apps) -->
                    <Border Height="1" Background="#40FFFFFF" Margin="2,4,2,2" />

                    <!-- NIVEL 3: cambiar sesión / estado -->
                    <Button Content="Cambiar a esta sesión" Style="{StaticResource ListRowAccent}"
                            Margin="0,8,0,0" Tag="{Binding SessionId}" Click="Switch_Click"
                            Visibility="{Binding CanSwitch, Converter={StaticResource BoolToVis}}" />
                    <!-- Mismo tamaño y forma que "Cambiar a esta sesión", pero gris y sin acción -->
                    <Border Style="{StaticResource ListRowDisabled}" Margin="0,8,0,0"
                            Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="En esta sesión" Foreground="#FF808080" FontSize="12"
                                   FontWeight="SemiBold" HorizontalAlignment="Center" />
                    </Border>
                    <Button Content="Iniciar sesión" Style="{StaticResource ListRowAccent}"
                            Margin="0,8,0,0" Click="StartLogon_Click"
                            Visibility="{Binding ShowStartButton, Converter={StaticResource BoolToVis}}" />
                    <!-- Sí / No: donde estaba «Iniciar sesión» -->
                    <Grid Margin="0,8,0,0"
                          Visibility="{Binding ShowConfirmButtons, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Sí" Style="{StaticResource ListRowAccent}"
                                Margin="0" Click="StartLogonYes_Click" />
                        <Button Grid.Column="2" Content="No" Style="{StaticResource ListRowAccent}"
                                Margin="0" Click="StartLogonNo_Click" />
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Menú de configuración (la caja). El encabezado se puede arrastrar. -->
        <Popup x:Name="ConfigPopup" PlacementTarget="{Binding ElementName=Box}" Placement="Custom"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Opened="Popup_Opened">
            <Border Background="{StaticResource MenuPanelBrush}" CornerRadius="{StaticResource MenuCornerRadius}" Padding="12">
                <StackPanel>
                    <Button Content="Etiquetas" Style="{StaticResource ListRow}" Click="ToggleLabels_Click" />
                    <Button Content="Visor" Style="{StaticResource ListRow}" Click="Visor_Click" />
                    <Button Content="Actualizar" Style="{StaticResource ListRow}" Click="Update_Click" />
                    <Button Content="Salir" Style="{StaticResource ListRow}" Margin="0" Click="Exit_Click" />

                    <TextBlock x:Name="StatusText" Foreground="#FFFF8A65" FontSize="11"
                               TextWrapping="Wrap" MaxWidth="260" Margin="2,6,0,0" Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </Popup>

        <!-- Aviso cuando no hay gatos (p. ej. el servicio no está en ejecución) -->
        <Border x:Name="EmptyHint" Background="#CC202124" CornerRadius="8" Padding="12,8"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8"
                IsHitTestVisible="False" Visibility="Collapsed">
            <TextBlock x:Name="EmptyHintText" Foreground="#FFFFD633" FontSize="12"
                       FontFamily="Consolas" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420" />
        </Border>

    </Grid>
</Window>
