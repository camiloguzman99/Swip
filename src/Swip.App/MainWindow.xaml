<Window x:Class="Swip.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Swip"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="Manual">

    <Grid>
        <!-- Área transparente donde merodean los gatos y vive la caja. -->
        <Canvas x:Name="Yard" Background="{x:Null}">
            <!-- Caja de configuración (arrastrable). Posición fijada en código. -->
            <Image x:Name="Box" Cursor="Hand"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                   RenderOptions.EdgeMode="Aliased"
                   MouseLeftButtonDown="Box_Down" MouseMove="Box_Move" MouseLeftButtonUp="Box_Up"
                   MouseRightButtonUp="BoxRight_Click" />
        </Canvas>

        <!-- Menú de cada gato (clic derecho), en 3 niveles. El encabezado se puede arrastrar. -->
        <Popup x:Name="InfoPopup" Placement="Custom" StaysOpen="False"
               AllowsTransparency="True" PopupAnimation="Fade" Opened="Popup_Opened">
            <Border Background="{StaticResource MenuPanelBrush}" CornerRadius="12" Padding="12" MinWidth="260">
                <StackPanel>
                    <!-- NIVEL 1: nombre + rueda de configuración (arrastrable) -->
                    <Border x:Name="CatHeader" Style="{StaticResource ListCard}"
                            Cursor="SizeAll"
                            MouseLeftButtonDown="InfoHeader_Down" MouseMove="InfoHeader_Move"
                            MouseLeftButtonUp="InfoHeader_Up">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}" Foreground="#FFFFFFFF"
                                           FontWeight="Bold" FontSize="13" FontFamily="Consolas" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource GearBtn}"
                                    VerticalAlignment="Center" Click="Gear_Click" ToolTip="Cambiar aspecto del gato">
                                <Ellipse Width="10" Height="10" Fill="#FFFFFFFF" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Panel de personalización (lo muestra/oculta la rueda) -->
                    <StackPanel x:Name="CatSettingsPanel" Visibility="Collapsed" Margin="0,2,0,0">
                        <TextBlock Text="Color" Foreground="#FF9AA0A6" FontSize="10" Margin="2,0,0,4" />
                        <WrapPanel>
                            <Button Style="{StaticResource Swatch}" Tag="orange" Click="Color_Click" Background="#FFF2913B" />
                            <Button Style="{StaticResource Swatch}" Tag="gray"   Click="Color_Click" Background="#FF8B8178" />
                        </WrapPanel>
                        <Grid Margin="0,2,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Engordar" Style="{StaticResource ListRow}"
                                    Margin="0,0,3,6" Click="Fatten_Click" />
                            <Button Grid.Column="1" Content="Adelgazar" Style="{StaticResource ListRow}"
                                    Margin="3,0,0,6" Click="Slim_Click" />
                        </Grid>
                    </StackPanel>

                    <!-- Separador 1px (encima de las apps) -->
                    <Border Height="1" Background="#40FFFFFF" Margin="2,6,2,2" />

                    <!-- NIVEL 2: apps abiertas en la otra sesión -->
                    <ItemsControl ItemsSource="{Binding Apps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ListCard}" Padding="10,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="#FFDADCE0"
                                                   FontSize="11" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding Cpu}" Foreground="#FF8FD0FF"
                                                   FontSize="11" FontFamily="Consolas" MinWidth="34"
                                                   TextAlignment="Right" Margin="8,0,0,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding Ram}" Foreground="#FFB7E39C"
                                                   FontSize="11" FontFamily="Consolas" MinWidth="34"
                                                   TextAlignment="Right" Margin="6,0,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Style="{StaticResource ListCard}" Padding="10,6"
                            Visibility="{Binding AppsLoading, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Cargando…" Foreground="#FF808080" FontSize="11" />
                    </Border>

                    <!-- Separador 1px (debajo de las apps) -->
                    <Border Height="1" Background="#40FFFFFF" Margin="2,4,2,2" />

                    <!-- NIVEL 3: cambiar sesión / estado -->
                    <Button Content="Cambiar a esta sesión" Style="{StaticResource ListRowAccent}"
                            Margin="0,8,0,0" Tag="{Binding SessionId}" Click="Switch_Click"
                            Visibility="{Binding CanSwitch, Converter={StaticResource BoolToVis}}" />
                    <!-- Mismo tamaño y forma que "Cambiar a esta sesión", pero gris y sin acción -->
                    <Border Style="{StaticResource ListRowDisabled}" Margin="0,8,0,0"
                            Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="En esta sesión" Foreground="#FF808080" FontSize="12"
                                   FontWeight="SemiBold" HorizontalAlignment="Center" />
                    </Border>
                    <Button Content="Iniciar sesión" Style="{StaticResource ListRowAccent}"
                            Margin="0,8,0,0" Click="StartLogon_Click"
                            Visibility="{Binding ShowNoSession, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>
        </Popup>

        <!-- Menú de configuración (la caja). El encabezado se puede arrastrar. -->
        <Popup x:Name="ConfigPopup" PlacementTarget="{Binding ElementName=Box}" Placement="Custom"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Opened="Popup_Opened">
            <Border Background="{StaticResource MenuPanelBrush}" CornerRadius="12" Padding="12">
                <StackPanel>
                    <Button Content="Etiquetas" Style="{StaticResource ListRow}" Click="ToggleLabels_Click" />
                    <Button Content="Actualizar" Style="{StaticResource ListRow}" Click="Update_Click" />
                    <Button Content="Salir" Style="{StaticResource ListRow}" Margin="0" Click="Exit_Click" />

                    <TextBlock x:Name="StatusText" Foreground="#FFFF8A65" FontSize="11"
                               TextWrapping="Wrap" MaxWidth="260" Margin="2,6,0,0" Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </Popup>

        <!-- Aviso cuando no hay gatos (p. ej. el servicio no está en ejecución) -->
        <Border x:Name="EmptyHint" Background="#CC202124" CornerRadius="8" Padding="12,8"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8"
                IsHitTestVisible="False" Visibility="Collapsed">
            <TextBlock x:Name="EmptyHintText" Foreground="#FFFFD633" FontSize="12"
                       FontFamily="Consolas" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420" />
        </Border>

    </Grid>
</Window>
