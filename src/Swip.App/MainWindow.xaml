<Window x:Class="Swip.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Swip"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="Manual">

    <Grid>
        <!-- Área transparente donde merodean los gatos y vive la casa. -->
        <Canvas x:Name="Yard" Background="{x:Null}">
            <!-- Casa de configuración (esquina). Posición fijada en código. -->
            <Image x:Name="Box" Cursor="Hand"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                   RenderOptions.EdgeMode="Aliased"
                   MouseLeftButtonDown="Box_Click"
                   MouseRightButtonUp="Box_Click" />
        </Canvas>

        <!-- Menú de cada gato (clic derecho), en formato lista redondeada. -->
        <Popup x:Name="InfoPopup" Placement="Top" StaysOpen="False"
               AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="#FF202124" CornerRadius="12" Padding="10" MinWidth="250"
                    BorderBrush="#FFFFC400" BorderThickness="1.5">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.5" />
                </Border.Effect>
                <StackPanel>
                    <!-- Nombre de usuario + estado -->
                    <Border Style="{StaticResource ListCard}" Background="#FF33341A">
                        <StackPanel>
                            <TextBlock Text="{Binding DisplayName}" Foreground="#FFFFD633"
                                       FontWeight="Bold" FontSize="13" FontFamily="Consolas" />
                            <TextBlock Text="{Binding StateText}" Foreground="#FFB0B0B0" FontSize="11" />
                        </StackPanel>
                    </Border>

                    <!-- Apps abiertas -->
                    <TextBlock Text="Apps abiertas" Foreground="#FF9AA0A6" FontSize="10" Margin="2,2,0,4" />
                    <ItemsControl ItemsSource="{Binding Apps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ListCard}" Padding="10,6">
                                    <TextBlock Text="{Binding}" Foreground="#FFDADCE0" FontSize="11"
                                               TextTrimming="CharacterEllipsis" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Style="{StaticResource ListCard}" Padding="10,6"
                            Visibility="{Binding AppsLoading, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Cargando apps…" Foreground="#FF808080" FontSize="11" />
                    </Border>

                    <!-- Personalizar: color y gordura -->
                    <TextBlock Text="Color" Foreground="#FF9AA0A6" FontSize="10" Margin="2,4,0,4" />
                    <WrapPanel>
                        <Button Style="{StaticResource Swatch}" Tag="amarillo" Click="Color_Click" Background="#FFFFCD1A" />
                        <Button Style="{StaticResource Swatch}" Tag="naranja"  Click="Color_Click" Background="#FFF2913B" />
                        <Button Style="{StaticResource Swatch}" Tag="gris"     Click="Color_Click" Background="#FFAEB6BD" />
                        <Button Style="{StaticResource Swatch}" Tag="negro"    Click="Color_Click" Background="#FF4A4A4A" />
                        <Button Style="{StaticResource Swatch}" Tag="blanco"   Click="Color_Click" Background="#FFF2F2F2" />
                        <Button Style="{StaticResource Swatch}" Tag="marron"   Click="Color_Click" Background="#FFA9743F" />
                    </WrapPanel>

                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Engordar" Style="{StaticResource ListRow}"
                                Margin="0,0,3,6" Click="Fatten_Click" />
                        <Button Grid.Column="1" Content="Adelgazar" Style="{StaticResource ListRow}"
                                Margin="3,0,0,6" Click="Slim_Click" />
                    </Grid>

                    <!-- Cambiar (última opción) -->
                    <Button Content="Cambiar a esta sesión" Style="{StaticResource ListRowAccent}"
                            Margin="0,4,0,0" Tag="{Binding SessionId}" Click="Switch_Click"
                            Visibility="{Binding CanSwitch, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>
        </Popup>

        <!-- Menú de configuración (la casa), en formato lista redondeada. -->
        <Popup x:Name="ConfigPopup" PlacementTarget="{Binding ElementName=Box}" Placement="Top"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="#FF202124" CornerRadius="12" Padding="10" MinWidth="230"
                    BorderBrush="#FFFFC400" BorderThickness="1.5">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.5" />
                </Border.Effect>
                <StackPanel>
                    <Border Style="{StaticResource ListCard}" Background="#FF33341A">
                        <TextBlock Text="Configuración de Swip" Foreground="#FFFFD633"
                                   FontWeight="Bold" FontSize="13" FontFamily="Consolas" />
                    </Border>

                    <Button x:Name="MoveBtn" Content="Mover ventana" Style="{StaticResource ListRow}"
                            Click="ToggleMove_Click" />
                    <Button x:Name="VisibleBtn" Content="Hacer visible la ventana"
                            Style="{StaticResource ListRow}" Click="ToggleVisible_Click" />
                    <Button Content="Aumentar tamaño de gatos" Style="{StaticResource ListRow}"
                            Click="CatsBigger_Click" />
                    <Button Content="Disminuir tamaño de gatos" Style="{StaticResource ListRow}"
                            Click="CatsSmaller_Click" />
                    <Button Content="Aumentar alto de la franja" Style="{StaticResource ListRow}"
                            Click="StripTaller_Click" />
                    <Button Content="Disminuir alto de la franja" Style="{StaticResource ListRow}"
                            Click="StripShorter_Click" />
                    <Button x:Name="LabelsBtn" Content="Ocultar etiquetas" Style="{StaticResource ListRow}"
                            Click="ToggleLabels_Click" />
                    <Button Content="Recolocar sobre la barra" Style="{StaticResource ListRow}"
                            Click="SnapToTaskbar_Click" />
                    <Button Content="Actualizar Swip" Style="{StaticResource ListRow}"
                            Click="Update_Click" />
                    <Button Content="Salir" Style="{StaticResource ListRow}" Click="Exit_Click" />

                    <TextBlock x:Name="StatusText" Foreground="#FFFF8A65" FontSize="11"
                               TextWrapping="Wrap" Margin="2,6,0,0" Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </Popup>

        <!-- Aviso cuando no hay gatos (p. ej. el servicio no está en ejecución) -->
        <Border x:Name="EmptyHint" Background="#CC202124" CornerRadius="8" Padding="12,8"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8"
                IsHitTestVisible="False" Visibility="Collapsed">
            <TextBlock x:Name="EmptyHintText" Foreground="#FFFFD633" FontSize="12"
                       FontFamily="Consolas" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420" />
        </Border>

        <!-- Aviso en modo mover -->
        <Border x:Name="MoveHint" Background="#EE202124" CornerRadius="8" Padding="12,8"
                HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                IsHitTestVisible="False" BorderBrush="#FFFFC400" BorderThickness="1.5">
            <TextBlock Foreground="#FFFFE08A" FontSize="12" FontFamily="Consolas" TextAlignment="Center"
                       Text="Arrastra la franja a su sitio.&#x0a;Pulsa la caja 📦 para terminar." />
        </Border>
    </Grid>
</Window>
