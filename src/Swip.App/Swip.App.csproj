<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Swip</AssemblyName>
    <RootNamespace>Swip.App</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Swip.Shared\Swip.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Hojas de sprites generadas por tools/art/build_atlas.py (el arte de origen vive en art/). -->
    <Resource Include="Assets\atlas\*.png" />
    <Resource Include="Assets\atlas\atlas.json" />
    <Resource Include="Assets\atlas\visor.json" />
    <Resource Include="Assets\box\*.png" />
  </ItemGroup>

</Project>
